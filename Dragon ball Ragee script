-- Variables
local farmEnabled = false
local farmRunning = false
local zenkaiEnabled = false
local zenkaiRunning = false

-- ========== AUTO FARM ==========
local function holdKey(key, duration)
	if not farmEnabled then return end
	VIM:SendKeyEvent(true, key, false, game)
	task.wait(duration)
	VIM:SendKeyEvent(false, key, false, game)
end

local function autoFarmLoop()
	while farmEnabled do
		holdKey(Enum.KeyCode.E, 10)
		if not farmEnabled then break end
		task.wait(1)

		holdKey(Enum.KeyCode.R, 10)
		if not farmEnabled then break end
		task.wait(1)

		holdKey(Enum.KeyCode.C, 5)
		if not farmEnabled then break end
		task.wait(1)

		holdKey(Enum.KeyCode.Q, 10)
		if not farmEnabled then break end
		task.wait(1)

		holdKey(Enum.KeyCode.C, 5)
		if not farmEnabled then break end
		task.wait(1)
	end
	farmRunning = false
end

-- ========== AUTO ZENKAI ==========
local function clickAt(x, y)
	if not zenkaiEnabled then return end
	VIM:SendMouseButtonEvent(x, y, 0, true, game, 1)
	task.wait(0.05)
	VIM:SendMouseButtonEvent(x, y, 0, false, game, 1)
end

local function autoZenkaiLoop()
	while zenkaiEnabled do
		clickAt(971, 888)
		if not zenkaiEnabled then break end
		task.wait(1)

		clickAt(685, 748)
		if not zenkaiEnabled then break end
		task.wait(1)
	end
	zenkaiRunning = false
end

-- ========== BOTONES ==========
farmBtn.MouseButton1Click:Connect(function()
	farmEnabled = not farmEnabled

	if farmEnabled then
		farmBtn.Text = "Auto Farm: ON"
		farmBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
		if not farmRunning then
			farmRunning = true
			task.spawn(autoFarmLoop)
		end
	else
		farmBtn.Text = "Auto Farm: OFF"
		farmBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
	end
end)

zenkaiBtn.MouseButton1Click:Connect(function()
	zenkaiEnabled = not zenkaiEnabled

	if zenkaiEnabled then
		zenkaiBtn.Text = "Auto Zenkai: ON"
		zenkaiBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
		if not zenkaiRunning then
			zenkaiRunning = true
			task.spawn(autoZenkaiLoop)
		end
	else
		zenkaiBtn.Text = "Auto Zenkai: OFF"
		zenkaiBtn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
	end
end)

-- Hacer el frame arrastrable
local dragging = false
local dragStart, startPos

frame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = frame.Position
	end
end)

frame.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

print("Auto Tools cargado correctamente")
